# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=  # Optional: limit to specific guild

# People in your server (optional but recommended)
# Map Discord user IDs to the names the bot should use. Anyone not listed is
# called by their Discord display name. Get IDs via Developer Mode -> right-click user -> Copy User ID.
USER_NAMES={"123456789012345678": "Alice", "234567890123456789": "Bob"}
# Optional light-hearted roasts the bot may RARELY work into answers. Leave empty to disable.
USER_ROASTS={}
# Example: USER_ROASTS={"Alice": "always goes AFK mid-raid.", "Bob": "has never won a game."}

# Voice channel to auto-join on startup (default: first channel with people in it)
AUTO_JOIN_VOICE=true
AUTO_JOIN_CHANNEL=

# Wake Word Detection
WAKE_WORD_METHOD=openwakeword  # openwakeword or whisper
WAKE_WORD_CONFIDENCE=0.7
WAKE_WORD_PHRASE=hey claude

# STT is Groq Whisper; GROQ_API_KEY is in the Groq section below

# TTS (Inworld)
INWORLD_API_KEY=your_inworld_api_key_here  # Get from https://studio.inworld.ai
TTS_MODEL=inworld-tts-1.5-mini  # inworld-tts-1-max (quality) or inworld-tts-1.5-mini (fast)
TTS_VOICE=alex  # alex, hades, luna, etc.
TTS_TEMPERATURE=1.1  # 0.0-2.0, higher = more expressive (default: 1.1)
TTS_SPEED=1.0  # 0.5-1.5, talking speed multiplier (default: 1.0)

# LLM - Qwen on Cerebras (OpenAI-compatible API)
# Get a key at https://cloud.cerebras.ai. Use pay-as-you-go: the free tier's
# 5 requests/min is too low for a voice bot (one turn with a tool call = 2 requests).
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=high  # none | low | medium | high (reasoning is never spoken)
LLM_MAX_COMPLETION_TOKENS=16384  # Per model turn; reasoning tokens count against this
LLM_HISTORY_MAX_MESSAGES=60  # Voice conversation memory per session

# Groq - used for Whisper speech-to-text and the dynamic thinking phrases
GROQ_API_KEY=your_groq_api_key_here  # Get from https://console.groq.com

# Web lookup - ddgs metasearch + local page reader. No keys or hosted services.
WEB_TOOLS_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_EXTRACT_MAX_CHARS=15000  # Per page; web_extract reads up to 5 pages in parallel

# Image generation (Nano Banana / Gemini) - off by default
IMAGE_GENERATION_ENABLED=false
NANOBANANA_API_KEY=

# Deep research via OpenAI (Codex/ChatGPT subscription sign-in) - not wired up yet
DEEP_RESEARCH_ENABLED=false

# Speaking Detection (multi-user awareness)
SPEAKING_DETECTION_ENABLED=false  # Enable to detect when others are talking
SPEAKING_SILENCE_DEBOUNCE_MS=3000  # Ms of silence before state changes to "silence"
SPEAKING_ENERGY_THRESHOLD=0.01  # Audio energy threshold to detect speech
SPEAKER_ISOLATION_ENABLED=true  # Filter audio from non-wake-word speakers

# Latency Settings
VAD_SENSITIVITY=0.5
SPEECH_PAD_MS=300
MAX_QUESTION_DURATION=30.0

# Audio
SAMPLE_RATE=16000
CHUNK_DURATION_MS=30

# Logging
LOG_LEVEL=INFO
LOG_LATENCY_METRICS=true
