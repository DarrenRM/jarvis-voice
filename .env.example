# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=  # Optional: limit to specific guild

# Note: No API key needed - uses Claude Code SDK in headless mode
# Make sure you're logged into Claude Code: claude auth login

# Wake Word Detection
WAKE_WORD_METHOD=openwakeword  # openwakeword or whisper
WAKE_WORD_CONFIDENCE=0.7
WAKE_WORD_PHRASE=hey claude

# STT - Groq Whisper (fast), Deepgram Flux, or local Whisper (offline fallback)
STT_PROVIDER=groq  # groq (fast), deepgram, or whisper (offline)
DEEPGRAM_API_KEY=your_deepgram_api_key_here  # Get from https://console.deepgram.com
# Note: GROQ_API_KEY is defined in the LLM section below (shared with LLM)
# Whisper fallback settings
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# TTS (Qwen3)
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B
TTS_DEVICE=cuda:0
TTS_VOICE=default

# LLM Provider Selection
# Options: claude (default), llama (Llama 3.3 70B), gpt-oss (GPT-OSS 120B)
LLM_PROVIDER=claude

# Claude LLM (used when LLM_PROVIDER=claude)
CLAUDE_MODEL=haiku  # haiku (fast), sonnet (balanced), opus (best quality)

# Groq LLM (used when LLM_PROVIDER=llama or gpt-oss)
# Note: GROQ_API_KEY is also used for Groq Whisper STT
GROQ_API_KEY=your_groq_api_key_here  # Get from https://console.groq.com
GROQ_MAX_TOKENS=1024

# Search Pipeline (used when LLM_PROVIDER=llama or gpt-oss for tool use)
# Start Firecrawl: docker compose -f docker-compose.firecrawl.yml up -d
FIRECRAWL_URL=http://localhost:3002
FIRECRAWL_API_KEY=  # Optional, not needed for self-hosted
SEARCH_MAX_RESULTS=3

# Speaking Detection (multi-user awareness)
SPEAKING_DETECTION_ENABLED=false  # Enable to detect when others are talking
SPEAKING_SILENCE_DEBOUNCE_MS=3000  # Ms of silence before state changes to "silence"
SPEAKING_ENERGY_THRESHOLD=0.01  # Audio energy threshold to detect speech
SPEAKER_ISOLATION_ENABLED=true  # Filter audio from non-wake-word speakers

# Latency Settings
VAD_SENSITIVITY=0.5
SPEECH_PAD_MS=300
MAX_QUESTION_DURATION=30.0
CLAUDE_TIMEOUT=30.0

# Audio
SAMPLE_RATE=16000
CHUNK_DURATION_MS=30

# Logging
LOG_LEVEL=INFO
LOG_LATENCY_METRICS=true
