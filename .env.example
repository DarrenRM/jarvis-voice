# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_GUILD_ID=  # Optional: the server whose MONITOR_CHANNEL_NAME the live monitor posts to

# People in your server (optional but recommended)
# Map Discord user IDs to the names the bot should use. Anyone not listed is
# called by their Discord display name. Get IDs via Developer Mode -> right-click user -> Copy User ID.
USER_NAMES={"123456789012345678": "Alice", "234567890123456789": "Bob"}
# Optional light-hearted roasts the bot may RARELY work into answers. Leave empty to disable.
USER_ROASTS={}
# Example: USER_ROASTS={"Alice": "always goes AFK mid-raid.", "Bob": "has never won a game."}

# Voice channel to join on startup, by name (empty: the first voice channel of the first server)
AUTO_JOIN_VOICE=true
AUTO_JOIN_CHANNEL=

# Wake Word Detection (openWakeWord, one detector per speaker)
WAKE_WORD_MODEL=hey_jarvis  # openWakeWord pretrained model, downloaded on first use
WAKE_WORD_CONFIDENCE=0.7

# STT is Groq Whisper; GROQ_API_KEY is in the Groq section below

# TTS (Inworld)
INWORLD_API_KEY=your_inworld_api_key_here  # Get from https://studio.inworld.ai
TTS_MODEL=inworld-tts-2-flash  # or inworld-tts-2 (style tags, ~2x slower per clip, pricier); Flash ignores TTS_TEMPERATURE
TTS_VOICE=alex  # alex, hades, luna, etc.
TTS_TEMPERATURE=1.1  # 0.0-2.0, higher = more expressive (default: 1.1)
TTS_SPEED=1.0  # 0.5-1.5, talking speed multiplier (default: 1.0)

# LLM - Qwen on Cerebras (OpenAI-compatible API)
# Get a key at https://cloud.cerebras.ai. Use pay-as-you-go: the free tier's
# 5 requests/min is too low for a voice bot (one turn with a tool call = 2 requests).
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=qwen-3.8-27b
CEREBRAS_REASONING_EFFORT=high  # none | low | medium | high (reasoning is never spoken)
LLM_MAX_COMPLETION_TOKENS=16384  # Per model turn; reasoning tokens count against this
LLM_TIMEOUT_SECONDS=60  # Per request to Cerebras
LLM_HISTORY_MAX_MESSAGES=60  # Voice conversation memory per session
# A second, request-specific filler line ("I'll look that up") after "Sure, Sam...":
# one extra Cerebras call per turn
DYNAMIC_THINKING_ENABLED=false

# Groq - Whisper speech-to-text
GROQ_API_KEY=your_groq_api_key_here  # Get from https://console.groq.com

# Web lookup - TinyFish hosted search/reader if keyed, else ddgs metasearch + local reader
WEB_TOOLS_ENABLED=true
# auto = TinyFish when TINYFISH_API_KEY is set (hosted search + page reading, not
# throttled by this IP; free 12k searches + 1k pages/day), else local ddgs + reader.
# local = always ddgs + local reader. TinyFish errors fall back to local.
WEB_BACKEND=auto
TINYFISH_API_KEY=  # https://agent.tinyfish.ai/api-keys
WEB_SEARCH_MAX_RESULTS=5
WEB_EXTRACT_MAX_CHARS=15000  # Per page; web_extract reads up to 5 pages in parallel

# Text channel the bot posts to: generated images, tagged messages and chat posts
IMAGE_CHANNEL_NAME=general

# Image generation (Nano Banana / Gemini) - off by default
IMAGE_GENERATION_ENABLED=false
NANOBANANA_API_KEY=

# Speaking Detection (multi-user awareness). On: the bot waits for the room to go quiet
# before it answers, and follow-up windows only count down while nobody else is talking.
SPEAKING_DETECTION_ENABLED=true
SPEAKING_SILENCE_DEBOUNCE_MS=3000  # Ms of silence before state changes to "silence"
SPEAKING_ENERGY_THRESHOLD=0.01  # Audio energy threshold to detect speech
SPEAKER_ISOLATION_ENABLED=true  # Filter audio from non-wake-word speakers

# Latency Settings
VAD_SENSITIVITY=0.5
SPEECH_PAD_MS=300
MIN_SILENCE_MS=2000  # Quiet that ends a question (room for "um... so..." pauses)
MAX_QUESTION_DURATION=30.0

# Carry on without the wake word. Listens only to the person the bot just answered, and
# skips speech that a quick check says was meant for someone else in the channel.
FOLLOWUP_ENABLED=true
FOLLOWUP_WINDOW_SECONDS=10.0  # After the bot asks a question: time to start your reply
FOLLOWUP_AFTER_ANSWER=true  # After a plain answer: listen too, but only for a new question or a correction
FOLLOWUP_AFTER_ANSWER_SECONDS=4.0
# The windows above only count down while the room is quiet (SPEAKING_DETECTION_ENABLED).
# When someone else stops talking, the person gets at least FOLLOWUP_GRACE_SECONDS to
# start; never over the max.
FOLLOWUP_GRACE_SECONDS=3.0
FOLLOWUP_MAX_WAIT_SECONDS=30.0
# Optional TypeSafe key. It does two things: TypeSafe Jev makes the "talking to the bot?"
# check (else Qwen does), and it turns on the automatic chat posts below.
TYPESAFE_API_KEY=
CHAT_POSTS_ENABLED=true  # Recipes/steps/stats also posted to IMAGE_CHANNEL_NAME (needs TYPESAFE_API_KEY)

# The bot also speaks unprompted, both on by default:
# greetings - it says hello (an LLM line) to people who join its voice channel,
# waiting up to GREETING_TIMEOUT_SECONDS for a quiet moment, at most once per
# GREETING_COOLDOWN_SECONDS per person
GREETING_ENABLED=true
GREETING_TIMEOUT_SECONDS=10
GREETING_COOLDOWN_SECONDS=300
# keep-alive - after this long idle it says a short line so Discord doesn't drop it
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=3000
# KEEP_ALIVE_PROMPT=  # Optional: what the model is asked to say (default in src/config.py)

# Live monitor - off by default. Watches real voice turns and posts problems
# (error replies, give-ups, slow or silent turns, tool failures, TTS repeats...) to a
# text channel with check/cross reactions. The owner's check adds the issue to
# MONITOR_APPROVED_FILE; a cross adds it to MONITOR_DISMISSED_FILE. Bot needs Send
# Messages, Add Reactions and Read Message History in that channel.
MONITOR_ENABLED=false
MONITOR_CHANNEL_NAME=bot-monitor
MONITOR_OWNER_ID=  # Your Discord user ID; only your reactions count
MONITOR_APPROVED_FILE=docs/approved-fixes.md  # Your check: something went wrong here
MONITOR_DISMISSED_FILE=docs/dismissed-findings.md  # Your cross: fine, or didn't disrupt the flow
MONITOR_SAVE_AUDIO=false  # Keep questions and wake word clips in MONITOR_AUDIO_DIR (local only)
MONITOR_AUDIO_DIR=recordings
MONITOR_AUDIO_MAX_MB=1000  # Oldest recordings are deleted past this
MONITOR_WAKE_CLIP_MIN_SCORE=0.2  # Keep near misses scoring at least this (hits always)
MONITOR_RETRANSCRIBE=false  # Re-transcribe answers with Groq Whisper (extra call per turn)
MONITOR_DEDUPE_MINUTES=30  # Same problem again within this window: one post with a count
# Timing limits count from the end of the MIN_SILENCE_MS pause, not the speaker's last word
MONITOR_SLOW_FIRST_AUDIO_SECONDS=3.0  # Opening phrase; good turns ~0.1-0.2s after the pause
MONITOR_SLOW_ANSWER_SECONDS=8.0  # First answer sentence; good turns ~4s after the pause
MONITOR_SLOW_ANSWER_WEB_SECONDS=20.0  # Answer after a web lookup
MONITOR_LONG_GAP_SECONDS=2.5  # Silence between answer sentences (normal ~0.3s)
MONITOR_HANG_SECONDS=30.0  # No progress at all for this long: "bot went silent"

# Logging
LOG_LEVEL=INFO
